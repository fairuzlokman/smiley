# Database. Local dev uses a SQLite file; on Vercel the Turso integration injects a libsql:// URL + token.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Session signing secret (at least 32 characters). Generate one with: openssl rand -base64 48
JWT_SECRET=

# Vercel Blob. Leave empty locally to store uploads in public/uploads (development only).
# On Vercel, connecting a Blob store injects this; the SDK then authenticates with the platform OIDC token.
BLOB_STORE_ID=
